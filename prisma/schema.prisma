generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────────

enum Role {
  EMPLOYEE
  MANAGER
  COORDINATOR
  DIRECTOR
  ACCOUNTANT
  ADMIN
  SUPERUSER
  SALES
}

enum SupplierType {
  REPAIR_VENDOR
  PARTS_SUPPLIER
  BOTH
}

enum TaskStatus {
  LOGGED
  APPROVED
  REJECTED
  PENDING
}

enum QueryType {
  NEW_SALE
  RENT
  SALE_REPAIR
  RENT_REPAIR
  SALE_REPLACEMENT
  RENT_REPLACEMENT
  GENERAL_REPAIR
}

enum QueryStatus {
  RECORDED
  CONFIRMED
  MATERIAL_OUT
  ASSIGNED
  QC_CHECKED
  CLEANED
  CROSS_CHECKED
  RESOLVED
  DROPPED
}

enum QuotationStatus {
  RECORDED
  APPROVED_TO_PROCEED
  VISIT
  PRICE_RECEIVED
  DRAFT
  FINAL_APPROVAL
  SENT
  DROPPED
}

enum WarrantyStatus {
  ADDED
  WARRANTY_CLAIMED
  DROPPED
}

enum InternalRepairStatus {
  RECORDED
  CONFIRMED
  SENT_FOR_REPAIR
  RECEIVED_BACK
  QC_CHECKED
  READY
  SCRAPPED
  DROPPED
}

enum PartRequestStatus {
  RECORDED
  PRICING_RECEIVED
  APPROVED_BY_BOSS
  ORDERED
  RECEIVED
  DROPPED
}

enum PaymentFollowupStatus {
  ACTIVE
  RESOLVED
}

enum CallStatus {
  DID_NOT_ANSWER
  INVALID_CONTACT
  SWITCHED_OFF
  SOLD
  FOLLOW_UP
  DO_NOT_CALL
  DIFFERENT_REQUIREMENT
  PRICING_ISSUE
  QTY_INSUFFICIENT
  NO_REQUIREMENT_RIGHT_NOW
}

// ─── CORE MODELS ────────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  username       String    @unique
  password       String
  role           Role      @default(EMPLOYEE)
  is_active      Boolean   @default(true)
  deactivated_at DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Relations
  Tasks             Task[]           @relation("TaskOwner")
  AssignedTasks     Task[]           @relation("AssignedBy")
  EditedTasks       Task[]           @relation("EditedBy")

  QueryEvents            QueryEvent[]
  QuotationEvents        QuotationEvent[]
  InternalRepairEvents   InternalRepairEvent[]
  PartRequestEvents      PartRequestEvent[]
  WarrantyExchangeEvents WarrantyExchangeEvent[]

  PartRequests         PartRequest[]  @relation("PartRequester")
  ReplacementApprovals ServiceQuery[] @relation("ReplacementApprover")
  QueryConfirmedBy     ServiceQuery[] @relation("QueryConfirmer")
  QueryAssignedTo      ServiceQuery[] @relation("QueryAssignee")

  SalespersonTransactions Transaction[]      @relation("SalespersonTransactions")
  AccountantTransactions  Transaction[]      @relation("AccountantTransactions")
  TransactionAudits       TransactionAudit[]

  PaymentFollowupEvents PaymentFollowupEvent[]
  CallLogs              CallLog[]
  CallContacts          CallContact[]
  Customers             Customer[]
}

// ─── MODULE A: WORK LOGGING ─────────────────────────────

model Task {
  id                 String     @id @default(uuid())
  user_id            String
  user               User       @relation("TaskOwner", fields: [user_id], references: [id])
  log_date           DateTime?  @db.Date
  due_date           DateTime?  @db.Date
  description        String
  time_taken_minutes Int?
  remark             String?
  status             TaskStatus @default(LOGGED)

  // Assignment details
  assigned_by_id String?
  assigned_by    User?     @relation("AssignedBy", fields: [assigned_by_id], references: [id])

  // Manager audit trail
  manager_edit String?
  edited_by_id String?
  edited_by    User?     @relation("EditedBy", fields: [edited_by_id], references: [id])
  edited_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([status])
  @@index([log_date])
}

// ─── ENTITIES ───────────────────────────────────────────

model Customer {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  name       String
  phone      String?
  address    String?
  location   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  ServiceQueries ServiceQuery[]
  Quotations     Quotation[]
  Transactions   Transaction[]
  CallContacts   CallContact[]
  PartRequests   PartRequest[]

  @@index([user_id])
}

model Supplier {
  id         String       @id @default(uuid())
  name       String
  contact    String?
  address    String?
  type       SupplierType @default(BOTH)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  WarrantyExchanges WarrantyExchange[]
  InternalRepairs   InternalRepair[]
  PartRequests      PartRequest[]
  lineItems         LineItem[]

  @@index([type])
}

// ─── MODULE B: SERVICE DESK ─────────────────────────────

model ServiceQuery {
  id             String      @id @default(uuid())
  query_type     QueryType
  status         QueryStatus @default(RECORDED)
  customer_id    String
  customer       Customer    @relation(fields: [customer_id], references: [id])
  device_details String?

  // Validation / Rules fields
  replacement_reason String?
  replaced_with      String?

  replacement_approved_by_id String?
  replacement_approved_by    User?   @relation("ReplacementApprover", fields: [replacement_approved_by_id], references: [id])

  confirmed_by_id String?
  confirmed_by    User?   @relation("QueryConfirmer", fields: [confirmed_by_id], references: [id])

  assigned_to_id String?
  assigned_to    User?   @relation("QueryAssignee", fields: [assigned_to_id], references: [id])

  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  QueryEvents QueryEvent[]

  @@index([customer_id])
  @@index([status])
  @@index([query_type])
}

model QueryEvent {
  id         String       @id @default(uuid())
  query_id   String
  query      ServiceQuery @relation(fields: [query_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User         @relation(fields: [user_id], references: [id])
  action     String // e.g. "RECORDED → CONFIRMED"
  remark     String?
  created_at DateTime     @default(now())

  @@index([query_id])
}

// ─── COORDINATOR MODULES ────────────────────────────────

model Quotation {
  id              String           @id @default(uuid())
  customer_id     String
  customer        Customer         @relation(fields: [customer_id], references: [id])
  description     String
  amount          String?
  status          QuotationStatus  @default(RECORDED)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  QuotationEvents QuotationEvent[]

  @@index([customer_id])
  @@index([status])
}

model QuotationEvent {
  id           String    @id @default(uuid())
  quotation_id String
  quotation    Quotation @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  user_id      String
  user         User      @relation(fields: [user_id], references: [id])
  action       String
  remark       String?
  created_at   DateTime  @default(now())

  @@index([quotation_id])
}

model WarrantyExchange {
  id                     String                  @id @default(uuid())
  supplier_id            String
  supplier               Supplier                @relation(fields: [supplier_id], references: [id])
  device_details         String
  reason                 String
  exchange_with          String?
  status                 WarrantyStatus          @default(ADDED)
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt
  WarrantyExchangeEvents WarrantyExchangeEvent[]

  @@index([supplier_id])
  @@index([status])
}

model WarrantyExchangeEvent {
  id                   String           @id @default(uuid())
  warranty_exchange_id String
  warranty_exchange    WarrantyExchange @relation(fields: [warranty_exchange_id], references: [id], onDelete: Cascade)
  user_id              String
  user                 User             @relation(fields: [user_id], references: [id])
  action               String
  remark               String?
  created_at           DateTime         @default(now())

  @@index([warranty_exchange_id])
}

model InternalRepair {
  id                   String                @id @default(uuid())
  item_description     String
  supplier_id          String
  supplier             Supplier              @relation(fields: [supplier_id], references: [id])
  sent_date            DateTime              @db.Date
  received_date        DateTime?             @db.Date
  status               InternalRepairStatus  @default(RECORDED)
  notes                String?
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt
  InternalRepairEvents InternalRepairEvent[]

  @@index([supplier_id])
  @@index([status])
}

model InternalRepairEvent {
  id                 String         @id @default(uuid())
  internal_repair_id String
  internal_repair    InternalRepair @relation(fields: [internal_repair_id], references: [id], onDelete: Cascade)
  user_id            String
  user               User           @relation(fields: [user_id], references: [id])
  action             String
  remark             String?
  created_at         DateTime       @default(now())

  @@index([internal_repair_id])
}

model PartRequest {
  id                  String             @id @default(uuid())
  part_name           String
  customer_id         String
  customer            Customer           @relation(fields: [customer_id], references: [id])
  supplier_id         String?
  supplier            Supplier?          @relation(fields: [supplier_id], references: [id])
  requested_by_id     String
  requested_by        User               @relation("PartRequester", fields: [requested_by_id], references: [id])
  pricing_received_at DateTime?
  approved_by_boss_at DateTime?
  status              PartRequestStatus  @default(RECORDED)
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
  PartRequestEvents   PartRequestEvent[]

  @@index([customer_id])
  @@index([status])
}

model PartRequestEvent {
  id              String      @id @default(uuid())
  part_request_id String
  part_request    PartRequest @relation(fields: [part_request_id], references: [id], onDelete: Cascade)
  user_id         String
  user            User        @relation(fields: [user_id], references: [id])
  action          String
  remark          String?
  created_at      DateTime    @default(now())

  @@index([part_request_id])
}

// ─── MODULE C: ACCOUNTING ───────────────────────────────

enum TransactionType {
  SALE
  PURCHASE
  REPLACEMENT
  REPAIR
  RENT
  RETURN
}

enum ReturnType {
  SALE
  RENT
  PURCHASE
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
}

enum LineItemType {
  SERIALIZED
  BULK
  BUNDLE
}

model Transaction {
  id   String          @id @default(uuid())
  type TransactionType

  // Relations
  customer_id    String?
  customer       Customer? @relation(fields: [customer_id], references: [id])
  salesperson_id String?
  salesperson    User?     @relation("SalespersonTransactions", fields: [salesperson_id], references: [id])
  accountant_id  String
  accountant     User      @relation("AccountantTransactions", fields: [accountant_id], references: [id])

  // Financials
  total_value     Float         @default(0)
  amount_paid     Float         @default(0)
  pending_amount  Float         @default(0)
  payment_status  PaymentStatus @default(PENDING)
  payment_account String?       @db.Text
  remark          String?       @db.Text

  rent_start_date DateTime?
  return_type     ReturnType?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt


  LineItems LineItem[]
  Audits    TransactionAudit[]

  @@index([type])
  @@index([created_at])
  @@index([customer_id])
}

model LineItem {
  id             String      @id @default(uuid())
  transaction_id String
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  type        LineItemType
  supplier_id String
  supplier    Supplier    @relation(fields: [supplier_id], references: [id])

  // Basic Info
  category   String?
  item_model String?

  // For SERIALIZED
  serial_numbers String[] @default([])

  // For BULK / BUNDLE
  quantity Int?

  // For BUNDLE
  bundle_name       String?
  bundle_components Json?

  // Extensible Details
  make            String?
  processor       String?
  generation      String?
  ram_gb          Int?
  ssd_gb          Int?
  hdd_gb          Int?
  graphic_card    String?
  desktop_type    String?
  screen_size     String?
  ram_type        String?
  storage_type    String?
  peripheral_item String?

  // Serial / Identifier Array (for items like laptops if qty > 1)
  mis_numbers String[] @default([])

  // Specific to Repairs/Replacements
  defect             String?
  replacement_reason String?
  replaced_with      String?

  // Financials
  price_per_unit Float?
  total_price    Float?

  created_at DateTime @default(now())

  @@index([transaction_id])
}

model TransactionAudit {
  id             String      @id @default(uuid())
  transaction_id String
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  edited_by_id String
  edited_by    User   @relation(fields: [edited_by_id], references: [id])

  previous_state Json // Stores the whole Transaction object (including LineItems) before the edit
  remark         String?
  created_at     DateTime @default(now())

  @@index([transaction_id])
}

// ─── MODULE D: OFFICE ADMIN ─────────────────────────────

model PaymentFollowup {
  id             String                @id @default(uuid())
  client_name    String
  pending_amount Float                 @default(0)
  status         PaymentFollowupStatus @default(ACTIVE)
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt

  Events PaymentFollowupEvent[]

  @@index([status])
}

model PaymentFollowupEvent {
  id              String          @id @default(uuid())
  followup_id     String
  followup        PaymentFollowup @relation(fields: [followup_id], references: [id], onDelete: Cascade)
  user_id         String
  user            User            @relation(fields: [user_id], references: [id])
  action          String // e.g. "RECORDED", "FOLLOW_UP", "RESOLVED"
  amount_change   Float?
  previous_amount Float?
  remark          String?
  created_at      DateTime        @default(now())

  @@index([followup_id])
}

// ─── MODULE E: CLIENT CALLING ───────────────────────────

model CallContact {
  id          String    @id @default(uuid())
  user_id     String
  user        User      @relation(fields: [user_id], references: [id])
  name        String
  phone       String
  location    String?
  customer_id String?
  customer    Customer? @relation(fields: [customer_id], references: [id])
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  CallLogs CallLog[]

  @@index([user_id])
  @@index([phone])
}

model CallLog {
  id          String      @id @default(uuid())
  contact_id  String
  contact     CallContact @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  user_id     String
  user        User        @relation(fields: [user_id], references: [id])
  status      CallStatus
  remark      String?
  requirement String?
  price_given Float?
  price_asked Float?
  qty         Int?
  created_at  DateTime    @default(now())

  @@index([user_id])
  @@index([contact_id])
}

enum OptionType {
  CATEGORY
  GENERATION
  PROCESSOR
  DESKTOP_TYPE
  RAM_TYPE
  STORAGE_TYPE
  MAKE
  MODEL
}

enum CategoryFieldGroup {
  COMPUTE
  COMPUTE_DESKTOP
  DISPLAY
  STORAGE_RAM
  STORAGE_DISK
  PRINTER
  PERIPHERAL
  OTHER
}

model LineItemOption {
  id          String              @id @default(uuid())
  type        OptionType
  value       String
  field_group CategoryFieldGroup?
  sort_order  Int                 @default(0)
  is_active   Boolean             @default(true)
  created_at  DateTime            @default(now())

  @@unique([type, value])
  @@index([type, is_active])
}
